package AG;
import java.util.Scanner;
public class Q36 {
    public static void main(String[]args){
        Scanner sc = new Scanner(System.in);
        int a =sc.nextInt();
        for(int i=1;i<=a;i++){
            for(int y=1;y<=a-i;y++){
                System.out.print(" ");
            }
            for(int j=1;j<=i;j++){
                System.out.print(i+" ");
            }
            System.out.println();
        }
    }
}
