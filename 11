package AG;
import java.util.Scanner;
public class Q11 {
    public static void main(String[]args){
        Scanner sc=new Scanner(System.in);
        System.out.println("Enter the value of N: ");
        int n= sc.nextInt();
        float s=0;
        for(int i=1;i<=n;i++){
            if(i!=1){
                s=s+(1.0f/i);
            }else{
                s+=i;
            }
        }
        System.out.println(s);
    }
}
