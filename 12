package AG;
import java.util.Scanner;
public class Q12 {
    public static void main(String[]args){
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();
        int s= 0;
        int pow=1;
        for(int i=1;i<=n;i++){
            s+=pow;
            pow=pow*2;
        }
        System.out.println(s);
    }
}
