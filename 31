package AG;
import java.util.Scanner;
public class Q31 {
    public static void main(String[]args){
        Scanner sc = new Scanner(System.in);
        int a = sc.nextInt();
        int ori = a;
        int tem=0;
        while(a>0){
            int digit = a%10;
            tem = tem*10+digit;
            a/=10;
        }
        if(ori==tem){
            System.out.println("Palindrome");
        }else{
            System.out.println("Not a palindrome");
        }
    }
}
