package AG;
import java.util.Scanner;
public class Q17_pali {
    public static void main(String[]args){
        Scanner sc = new Scanner(System.in);
        int n=sc.nextInt();
        int ori=n;
        int rev = 0;
        while(n!=0){
            int dig=n%10;
            rev = rev*10+dig;
            n/=10;
        }
        if(ori==rev){
            System.out.println("Is Palindrome");
        }else{
            System.out.println("Not a Palindrome");
        }
    }
}
