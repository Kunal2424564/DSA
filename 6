package AG;
import java.util.Scanner;
public class Q6 {
    public static void main(String[]args){
        Scanner sc = new Scanner(System.in);
        System.out.println("Enter the value of N: ");
        int n=sc.nextInt();
        int s =0;
        int count=1;
        for(int i=1;i<=1000;i++){
            if(i%2!=0&&count<=n){
                s+=i;
                count++;
            }
        }
        System.out.println(s);
    }
}
