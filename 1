package AG;
import java.util.Scanner;
public class Q1 {
    public static void main(String[]args){
        Scanner sc = new Scanner(System.in);
        System.out.println("Tell me What type of customer is this: ");
        String cus = sc.nextLine();
        System.out.println("Is it happyhours: ");
        boolean isHappyhours = sc.nextBoolean();
        System.out.println("What was the amount: ");
        double bill = sc.nextDouble();
        double bill2;
        if(cus.equalsIgnoreCase("VIP")){
            if(isHappyhours){
                bill2=bill-bill*0.25;
                System.out.println("Your bill: " + bill2);
            }else{
                bill2 = bill-bill*0.15;
                System.out.println("Your bill: " + bill2);
            }
        }else if (cus.equalsIgnoreCase("Regular")) {

            if (isHappyhours && bill > 20) {
                bill2 = bill - (bill * 0.15);
                System.out.println("Your bill: "+bill2);// 15% discount
            } else if (bill > 20) {
                bill2 = bill - (bill * 0.10);
                System.out.println("Your bill: "+bill2);// 10% discount
            } else {
                bill2 = bill;
                System.out.println("Your bill: "+bill2);// No discount
            }

        }else if(cus.equalsIgnoreCase("guest")){
            if(isHappyhours&&bill>50){
                bill2=bill-5;
                System.out.println("Your bill: " + bill2);
            }else{
                bill2=bill;
                System.out.println("Your bill: " + bill2);
            }
        }
    }
}
